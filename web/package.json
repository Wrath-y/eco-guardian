{
  "name": "eco-guardian-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "generate:api": "openapi-typescript ../api/openapi.yaml -o src/api/generated.ts",
    "check:api": "npm run generate:api && git diff --exit-code -- src/api/generated.ts"
  },
  "dependencies": {
    "@tanstack/vue-query": "^5.66.0",
    "ant-design-vue": "^4.2.6",
    "pinia": "^3.0.1",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.0",
    "@testing-library/vue": "^8.1.0",
    "@types/node": "^22.13.4",
    "@typescript-eslint/parser": "^8.65.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^9.19.0",
    "eslint-plugin-vue": "^9.32.0",
    "jsdom": "^26.0.0",
    "openapi-typescript": "^7.6.1",
    "typescript": "~5.7.3",
    "vite": "^6.1.0",
    "vitest": "^3.0.5",
    "vue-tsc": "^2.2.0"
  }
}
