{
  "$id": "https://eco-guardian.local/schemas/package-manifest-v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "package_mode": {
            "const": "lightweight"
          }
        }
      },
      "then": {
        "properties": {
          "components": {
            "maxItems": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "package_mode": {
            "const": "complete"
          }
        }
      },
      "then": {
        "properties": {
          "components": {
            "allOf": [
              {
                "contains": {
                  "properties": {
                    "kind": {
                      "const": "local-rag"
                    }
                  },
                  "required": [
                    "kind"
                  ],
                  "type": "object"
                },
                "minContains": 1
              },
              {
                "contains": {
                  "properties": {
                    "kind": {
                      "const": "python-runtime"
                    }
                  },
                  "required": [
                    "kind"
                  ],
                  "type": "object"
                },
                "minContains": 1
              },
              {
                "contains": {
                  "properties": {
                    "kind": {
                      "const": "embedding-model"
                    }
                  },
                  "required": [
                    "kind"
                  ],
                  "type": "object"
                },
                "minContains": 1
              },
              {
                "contains": {
                  "properties": {
                    "kind": {
                      "const": "rerank-model"
                    }
                  },
                  "required": [
                    "kind"
                  ],
                  "type": "object"
                },
                "minContains": 1
              }
            ],
            "maxItems": 4,
            "minItems": 4
          }
        }
      }
    }
  ],
  "properties": {
    "components": {
      "items": {
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "kind": {
                  "enum": [
                    "local-rag",
                    "python-runtime"
                  ]
                }
              },
              "required": [
                "kind"
              ]
            },
            "then": {
              "required": [
                "entrypoint"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "enum": [
                    "embedding-model",
                    "rerank-model"
                  ]
                }
              },
              "required": [
                "kind"
              ]
            },
            "then": {
              "not": {
                "required": [
                  "entrypoint"
                ]
              }
            }
          }
        ],
        "properties": {
          "entrypoint": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]*$",
            "type": "string"
          },
          "files": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "path": {
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]*$",
                  "type": "string"
                },
                "role": {
                  "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
                  "type": "string"
                },
                "sha256": {
                  "pattern": "^[a-f0-9]{64}$",
                  "type": "string"
                },
                "size_bytes": {
                  "minimum": 0,
                  "type": "integer"
                }
              },
              "required": [
                "role",
                "path",
                "size_bytes",
                "sha256"
              ],
              "type": "object"
            },
            "minItems": 1,
            "type": "array"
          },
          "id": {
            "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
            "type": "string"
          },
          "kind": {
            "enum": [
              "local-rag",
              "python-runtime",
              "embedding-model",
              "rerank-model"
            ],
            "type": "string"
          },
          "version": {
            "maxLength": 256,
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "kind",
          "id",
          "version",
          "files"
        ],
        "type": "object"
      },
      "maxItems": 4,
      "type": "array"
    },
    "eco_guardian": {
      "additionalProperties": false,
      "properties": {
        "build": {
          "minLength": 1,
          "type": "string"
        },
        "commit": {
          "minLength": 1,
          "type": "string"
        },
        "executable": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]*$",
          "type": "string"
        },
        "runtime_status_schema_version": {
          "minLength": 1,
          "type": "string"
        },
        "sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        "size_bytes": {
          "minimum": 0,
          "type": "integer"
        },
        "version": {
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$",
          "type": "string"
        }
      },
      "required": [
        "version",
        "build",
        "commit",
        "runtime_status_schema_version",
        "executable",
        "size_bytes",
        "sha256"
      ],
      "type": "object"
    },
    "embedded_asset_digests": {
      "additionalProperties": {
        "pattern": "^[a-f0-9]{64}$",
        "type": "string"
      },
      "minProperties": 1,
      "type": "object"
    },
    "package_mode": {
      "enum": [
        "complete",
        "lightweight"
      ],
      "type": "string"
    },
    "schema_version": {
      "const": 1
    },
    "supported_platform": {
      "additionalProperties": false,
      "properties": {
        "architecture": {
          "const": "amd64"
        },
        "os": {
          "const": "windows"
        }
      },
      "required": [
        "os",
        "architecture"
      ],
      "type": "object"
    }
  },
  "required": [
    "schema_version",
    "package_mode",
    "supported_platform",
    "eco_guardian",
    "embedded_asset_digests",
    "components"
  ],
  "title": "Eco Guardian Package Manifest v1",
  "type": "object"
}
