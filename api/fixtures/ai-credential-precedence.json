{
  "provider": "openai-compatible",
  "environment_variable": "ECO_GUARDIAN_OPENAI_API_KEY",
  "environment_persistent": false,
  "precedence": [
    "credential_manager",
    "environment"
  ],
  "cases": [
    {
      "credential_manager_present": true,
      "environment_present": true,
      "resolved_source": "credential_manager"
    },
    {
      "credential_manager_present": false,
      "environment_present": true,
      "resolved_source": "environment"
    },
    {
      "credential_manager_present": false,
      "environment_present": false,
      "resolved_source": null
    }
  ]
}
